# Copy to .env locally. On Render, set these in the dashboard (Environment).

NODE_ENV=production
PORT=5000

# Required on Render
USE_ATLAS_DB=true
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/Eduaitor?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin (no trailing slash) — shared hosting production
CLIENT_URL=https://eduaitor.com
# Optional extra origins (comma-separated)
# CLIENT_URLS=https://www.eduaitor.com,https://admineduaitor.netlify.app

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Credential emails (SMTP). If unset, creates still succeed and emails are skipped/logged.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM="Eduaitor <noreply@yourdomain.com>"

OPENROUTER_API_KEY=
# OPENAI_API_KEY=
