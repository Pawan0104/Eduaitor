# SPA + static assets for Apache shared hosting (domain root)

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Real files always win (e.g. /ecosystem/01-admin.png)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Keep ERP / website CMS / mail relay on their own apps
  RewriteRule ^admin(/|$) - [L]
  RewriteRule ^admin-dashboard(/|$) - [L]
  RewriteRule ^mail-relay(/|$) - [L]

  # SPA routes that collide with public asset folders → React app
  # (without this, Apache serves the folder and returns 403 with -Indexes)
  RewriteRule ^(ecosystem|why|ignitex|contact|solutions|pricing|home|future-skills|delete-account)/?$ /index.html [L]

  # Other client-side routes with no physical folder
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]

  # Any remaining directory without its own index → SPA (safety net)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteCond %{REQUEST_FILENAME}/index.php !-f
  RewriteRule ^ /index.html [L]
</IfModule>

Options -Indexes

DirectoryIndex index.html index.php

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
