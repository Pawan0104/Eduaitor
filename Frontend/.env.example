# Local development
VITE_API_URL=http://localhost:5000/api

# Production build (shared hosting / Netlify) — set before npm run build,
# or copy .env.production.example → .env.production
# MUST include /api at the end:
#   VITE_API_URL=https://eduaitor-api.onrender.com/api
# (Build also auto-appends /api if you forget it.)

# Optional app URL (links / SEO)
# VITE_APP_URL=https://YOUR-DOMAIN.com

# Asset base for Vite (shared hosting):
#   VITE_BASE=/          ← domain or subdomain ROOT (recommended)
#   VITE_BASE=/admin/    ← only if dist is uploaded into a /admin folder
#                          (also need root rewrites for /school,/teacher,…)
# VITE_BASE=/

# Shared hosting upload checklist:
# 1) Set VITE_API_URL to Render API, then: npm run build
# 2) Upload ALL files from Frontend/dist/ to public_html (or subdomain docroot)
# 3) Confirm .htaccess was uploaded (SPA routing)
# 4) Render → Environment → CLIENT_URL=https://YOUR-DOMAIN.com (exact origin, no path)
# 5) Optional: CLIENT_URLS=https://www.YOUR-DOMAIN.com,https://admineduaitor.netlify.app
